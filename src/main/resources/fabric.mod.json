{
  "schemaVersion": 1,
  "id": "fleeinganimals",
  "version": "${version}",

  "name": "Fleeing Mobs",
  "description": "Change the behaviour of passive mobs to make them flee when other animals are hurt.",
  "authors": [
    "Feelzor"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/fleeing-animals",
    "issues": "https://github.com/FeelZoR/Fleeing-Animals/issues",
    "sources": "https://github.com/FeelZoR/Fleeing-Animals"
  },

  "license": "GPL-3.0 License",
  "icon": "assets/fleeinganimals/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": ["ovh.feelzor.fleeinganimals.FleeingAnimals"],
    "modmenu": ["ovh.feelzor.fleeinganimals.ModMenuIntegration"]
  },
  "mixins": [
    "fleeinganimals.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "cloth-config2": ">=${cloth_config_version}"
  },
  "suggests": {}
}
